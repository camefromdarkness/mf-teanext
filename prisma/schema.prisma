generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  MANAGER
  ADMIN
  SUPER_ADMIN
}

enum OrderStatus {
  PENDING
  PAID
  REJECTED
}

model User {
  id            String    @id @default(cuid())
  publicId      String    @unique @default(uuid()) @db.Uuid
  name          String?
  email         String?   @unique
  phoneNumber   String?   @db.VarChar(32)
  emailVerified DateTime?
  image         String?
  role          UserRole  @default(CUSTOMER)
  accounts      Account[]
  sessions      Session[]
  orders        Order[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Tea {
  id                   Int        @id @default(autoincrement())
  moyskladAssortmentId String?    @unique
  type                 String
  name                 String
  shortDesc            String
  price                Int
  discountPercent      Int        @default(20)
  unit                 String
  description          String     @db.Text
  details              Json
  isActive             Boolean    @default(true)
  sortOrder            Int        @default(0)
  images               TeaImage[]
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  @@index([isActive, sortOrder])
}

model TeaImage {
  id            String  @id @default(cuid())
  teaId         Int
  url           String
  alt           String  @default("")
  sortOrder     Int     @default(0)
  isCover       Boolean @default(false)
  showInGallery Boolean @default(true)
  tea           Tea     @relation(fields: [teaId], references: [id], onDelete: Cascade)

  @@unique([teaId, url])
  @@index([teaId, sortOrder])
}

model Order {
  id                   String      @id @default(cuid())
  checkoutKey          String?     @unique
  moyskladOrderId      String?     @unique
  moyskladSyncRequired Boolean     @default(false)
  userId               String?
  contactName          String?
  phoneNumber          String      @db.VarChar(32)
  status               OrderStatus @default(PENDING)
  moyskladStatus       String?
  moyskladStatusType   String?
  total                Int
  user                 User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  items                OrderItem[]
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  @@index([userId, createdAt])
}

model OrderItem {
  id                   String  @id @default(cuid())
  orderId              String
  teaId                Int?
  moyskladAssortmentId String?
  teaName              String
  teaUnit              String
  quantity             Int
  unitPrice            Int
  order                Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model MoyskladApiCircuit {
  id          String    @id
  blockedUntil DateTime?
  probeUntil  DateTime?
  lastStatus  Int?
  lastCode    Int?
  lastMessage String?   @db.VarChar(255)
  updatedAt   DateTime  @updatedAt
}
